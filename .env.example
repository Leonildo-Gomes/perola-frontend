# Leave empty to use the Next.js proxy (/api/v1/* -> BACKEND_URL): no CORS needed in dev.
# Set a full URL (e.g. https://api.perola.cv) to call the API directly; the backend must then allow this origin (CORS).
NEXT_PUBLIC_API_URL=
# Backend used by the proxy (server-side only).
BACKEND_URL=
# Google OAuth2 Web Client ID (Google Identity Services). Optional: Google button is disabled without it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional: admin sidebar WhatsApp support link (digits only, e.g. 2389912345).
NEXT_PUBLIC_SUPPORT_WHATSAPP=
